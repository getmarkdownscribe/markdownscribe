{
  "openapi": "3.1.0",
  "info": {
    "title": "MarkdownScribe",
    "description": "MarkdownScribe does the Markdown work in one API call: parse frontmatter, build a TOC, lint, format, render Mermaid to SVG, convert any URL to Markdown. Pay per credit.",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://markdownscribe.com/terms"
    },
    "contact": {
      "name": "MarkdownScribe support",
      "url": "https://markdownscribe.com/contact"
    }
  },
  "servers": [
    {
      "url": "https://api.markdownscribe.com",
      "description": "Production"
    }
  ],
