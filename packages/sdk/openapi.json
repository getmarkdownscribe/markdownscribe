                "$ref": "#/components/headers/X-Credits-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "findings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rule": {
                            "type": "string",
                            "pattern": "^MD\\d{3}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "column": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "message": {
                            "type": "string"
                          },
                          "detail": {
                            "type": "string"
                          },
                          "hint": {
                            "type": "string"
                          },
                          "doc_url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "rule",
                          "name",
                          "line",
                          "message",
                          "doc_url"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "total"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "description": "Same value as the X-Request-Id response header. Quote it in any bug report."
                        },
                        "duration_ms": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Server-side processing time for this operation."
                        },
                        "credits": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Credits charged for this call. Also in the X-Credits-Charged header."
                        }
                      },
                      "required": [
                        "request_id",
                        "duration_ms",
                        "credits"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "valid",
                    "findings",
                    "summary",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error",
            "description": "Invalid request body."
          },
          "401": {
            "$ref": "#/components/responses/Error",
            "description": "Missing or invalid API key."
          },
          "402": {
            "$ref": "#/components/responses/Error",
            "description": "Not enough credits."
          },
          "413": {
            "$ref": "#/components/responses/Error",
            "description": "Request body above the size limit."
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error",
            "description": "Unexpected server error."
          }
        },
        "x-credits": {
          "min": 2,
          "max": 2
        },
        "requestBody": {
