                      "type": "string"
                    },
                    "openapi": {
                      "type": "string"
                    },
                    "llms_txt": {
                      "type": "string"
                    },
                    "pricing": {
                      "type": "string"
                    },
                    "mcp": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
