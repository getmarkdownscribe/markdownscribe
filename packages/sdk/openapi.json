    "/v1/md/lint": {
      "post": {
        "operationId": "lintMarkdown",
        "summary": "Lint Markdown against structural rules",
        "description": "Returns every finding with rule, line and description, plus a summary. `valid` is true when nothing was found.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
