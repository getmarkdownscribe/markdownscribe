{
  "name": "@markdownscribe/sdk",
  "version": "0.2.0",
  "description": "MarkdownScribe does the Markdown work in one API call: parse frontmatter, build a TOC, lint, format, render Mermaid to SVG, convert any URL to Markdown. Pay per credit.",
  "keywords": [
    "markdown",
    "frontmatter",
    "toc",
    "table-of-contents",
    "lint",
    "markdown-lint",
    "format",
    "mermaid",
    "url-to-markdown",
    "sdk",
    "typescript",
    "api-client",
    "llm-tools",
    "agent-tools"
  ],
  "homepage": "https://github.com/markdownscribe/markdownscribe/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdownscribe/markdownscribe.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/markdownscribe/markdownscribe/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint TBD (eslint em fase futura)'",
    "clean": "rimraf dist coverage .turbo *.tsbuildinfo",
    "openapi:sync": "node scripts/openapi.mjs sync",
    "openapi:check": "node scripts/openapi.mjs check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
