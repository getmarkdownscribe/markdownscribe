{
  "name": "markdownscribe",
  "version": "0.2.0",
  "description": "MarkdownScribe does the Markdown work in one API call: parse frontmatter, build a TOC, lint, format, render Mermaid to SVG, convert any URL to Markdown. Pay per credit.",
  "keywords": [
    "markdown",
    "cli",
    "frontmatter",
    "toc",
    "table-of-contents",
    "lint",
    "markdown-lint",
    "format",
    "mermaid",
    "url-to-markdown",
    "command-line",
    "llm-tools",
    "agent-tools",
    "mdscribe"
  ],
  "homepage": "https://github.com/markdownscribe/markdownscribe/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdownscribe/markdownscribe.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/markdownscribe/markdownscribe/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "markdownscribe": "./dist/bin.js",
    "mdscribe": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint TBD (eslint em fase futura)'",
    "clean": "rimraf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@markdownscribe/sdk": "workspace:^",
    "commander": "^13.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
