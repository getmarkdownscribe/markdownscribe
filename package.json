    "openapi:check": "pnpm --filter @markdownscribe/sdk openapi:check",
    "context:cost": "node scripts/context-cost.mjs"
  },
  "devDependencies": {
    "js-tiktoken": "^1.0.21",
    "typescript": "^5.6.0"
  }
}
