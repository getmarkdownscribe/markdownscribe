{
  "name": "MarkdownScribe",
  "short_name": "MarkdownScribe",
  "description": "MarkdownScribe does the Markdown work in one API call: parse frontmatter, build a TOC, lint, format, render Mermaid to SVG, convert any URL to Markdown. Pay per credit.",
